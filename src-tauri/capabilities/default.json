{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main: Ready, Repository SQL, events, fixed Quick Add/status and write lifecycle",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "main-database-boot-status",
    "main-show-quick-add",
    "main-global-shortcut-status",
    "main-lifecycle-status",
    "main-write-lifecycle",
    "sql:allow-select",
    "sql:allow-execute",
    "main-reminders",
    "main-backup-restore",
    "main-journal-export",
    "main-task-content",
    "main-autostart",
    "main-preferences"
  ]
}
